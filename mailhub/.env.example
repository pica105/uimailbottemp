# --- Telegram ---------------------------------------------------------------
# Get from @BotFather → /newbot
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Public HTTPS URL of the Next.js Mini App (deployed on Vercel)
MINI_APP_URL=https://your-app.vercel.app

# --- Network ----------------------------------------------------------------
# Public base URL of THIS backend (used for OAuth redirect URIs).
# Use https://your-backend.example.com in production; localhost for local dev.
BASE_URL=http://localhost:8080
HOST=0.0.0.0
PORT=8080

# --- Encryption --------------------------------------------------------------
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-44-char-fernet-key-here=

# --- OAuth: Google -----------------------------------------------------------
# https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client IDs
# Authorized redirect URI must include:  {BASE_URL}/oauth/gmail/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- OAuth: Yandex -----------------------------------------------------------
# https://oauth.yandex.ru/client/new
# Redirect URI: {BASE_URL}/oauth/yandex/callback
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret

# --- Storage ----------------------------------------------------------------
DB_PATH=./mailhub.db
